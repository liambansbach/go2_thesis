  <joint
    name="radar_joint"
    type="fixed">
    <!-- Copied from the original Unitree Go2-W URDF. Keep base->radar exact. -->
    <origin
      xyz="0.28945 0 -0.046825"
      rpy="0 2.8782 0" />
    <parent
      link="base" />
    <child
      link="radar" />
    <axis
      xyz="0 0 0" />
  </joint>
<!-- ===================================================================== -->
  <!-- RealSense D456 mount assembly                                         -->
  <!--                                                                       -->
  <!-- The original Go2-W URDF above this point is left unchanged.           -->
  <!-- The complete mount pose and the hole-aligned offsets are based on     -->
  <!-- the user's wr2 assembly, because that version already matched the     -->
  <!-- physical mount much better in the URDF viewer.                        -->
  <!--                                                                       -->
  <!-- All mechanical mount link frames below use the normal ROS body        -->
  <!-- convention at the nominal pose: x forward, y left, z up.              -->
  <!-- CAD/STL coordinate-system corrections are kept inside visual origins, -->
  <!-- so the fixed joints mostly contain only physical offsets.             -->
  <!--                                                                       -->
  <!-- STL files were exported in millimetres, so every mesh uses            -->
  <!-- scale="0.001 0.001 0.001".                                            -->
  <!-- ===================================================================== -->

  <link name="rs_base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
    <visual>
      <!-- CAD: x right, y up, z back -> ROS visual pose. -->
      <origin xyz="0 0 0" rpy="1.57079632679 0 -1.57079632679" />
      <geometry>
        <mesh
          filename="package://go2w_description/dae/rs_base.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="rs_base_material">
        <color rgba="0.25 0.25 0.25 1" />
      </material>
    </visual>
  </link>

  <joint name="rs_base_joint" type="fixed">
    <!-- Preserved from the user's wr2 assembly: this already placed the
         complete RealSense base correctly on the Go2-W body. -->
    <origin xyz="0.295 0 0.075" rpy="0 0 0" />
    <parent link="base" />
    <child link="rs_base" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="rs_tilt_axis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
  </link>

  <joint name="rs_tilt_axis_joint" type="fixed">
    <!-- Centre pitch/hinge axis reconstructed from the wr2 mount placement.
         Keep this fixed. Change rs_mount_pitch_joint below to adjust the
         real camera pitch angle. -->
    <origin xyz="0.005 0 0.032" rpy="0 0 0" />
    <parent link="rs_base" />
    <child link="rs_tilt_axis" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="rs_flange_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
    <visual>
      <!-- Derived from wr2: visual offset (0, -0.004, -0.005) in the
           original flange CAD frame, converted to the clean ROS link frame. -->
      <origin xyz="0.005 0 -0.004" rpy="1.57079632679 0 -1.57079632679" />
      <geometry>
        <mesh
          filename="package://go2w_description/dae/rs_flange.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="rs_flange_material">
        <color rgba="0.25 0.25 0.25 1" />
      </material>
    </visual>
  </link>

  <joint name="rs_flange_right_joint" type="fixed">
    <!-- Right side when looking in the Go2-W forward direction. Offset is
         transformed from the user's wr2 assembly, so the flange bores should
         line up with the mount again. -->
    <origin xyz="0 -0.02 -0.028" rpy="0 0 0" />
    <parent link="rs_tilt_axis" />
    <child link="rs_flange_right" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="rs_flange_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
    <visual>
      <!-- This is the mirrored flange side. The mesh file name intentionally
           follows the Go2-style _mirror convention. -->
      <origin xyz="0.005 0 -0.004" rpy="1.57079632679 0 -1.57079632679" />
      <geometry>
        <mesh
          filename="package://go2w_description/dae/rs_flange_mirror.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="rs_flange_material">
        <color rgba="0.25 0.25 0.25 1" />
      </material>
    </visual>
  </link>

  <joint name="rs_flange_left_joint" type="fixed">
    <!-- Left side when looking in the Go2-W forward direction. -->
    <origin xyz="0 0.02 -0.028" rpy="0 0 0" />
    <parent link="rs_tilt_axis" />
    <child link="rs_flange_left" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="rs_mount">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
    <visual>
      <!-- CAD: x right, y back, z down -> ROS visual pose. The xyz offset is
           the wr2 mount visual offset converted into the clean link frame. -->
      <origin xyz="0.02 0 0" rpy="3.14159265359 0 -1.57079632679" />
      <geometry>
        <mesh
          filename="package://go2w_description/dae/rs_mount.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="rs_mount_material">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
  </link>

  <joint name="rs_mount_pitch_joint" type="fixed">
    <!-- Mechanical pitch joint. At rpy="0 0 0" the geometry matches the
         user's wr2 alignment. Adjust the middle RPY value for camera pitch,
         e.g. rpy="0 -0.10 0". -->
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="rs_tilt_axis" />
    <child link="rs_mount" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="rs_d456_solid">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
    <visual>
      <!-- CAD: x left, y up, z forward -> ROS visual pose. The origin keeps
           the link frame approximately at the centre of the rear camera face,
           as in the user's wr2 version. -->
      <origin xyz="0 -0.063 -0.0145" rpy="1.57079632679 0 1.57079632679" />
      <geometry>
        <mesh
          filename="package://go2w_description/dae/rs_D456_Solid.STL"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="rs_d456_material">
        <color rgba="0.05 0.05 0.05 1" />
      </material>
    </visual>
  </link>

  <joint name="rs_d456_solid_joint" type="fixed">
    <!-- Preserved from wr2 after converting to the clean ROS mount frame. -->
    <origin xyz="0.02 0 0" rpy="0 0 0" />
    <parent link="rs_mount" />
    <child link="rs_d456_solid" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="front_realsense">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
  </link>

  <joint name="front_realsense_sensor_joint" type="fixed">
    <!-- RealSense ROS convention:
         front_realsense is the left IR / infra1 / depth-origin frame, not the
         mechanical rear-face centre. Its axes stay in ROS body convention:
         x forward, y left, z up. The RealSense wrapper publishes the
         child sensor and optical frames below front_realsense.

         D456 approximation from the current visual STL and D400 datasheet:
         - rs_d456_solid is at the centre of the rear camera face.
         - camera body depth in the STL is 26 mm.
         - D455/D456 depth start point is 4.55 mm behind the front glass.
           => x = 26.00 mm - 4.55 mm = 21.45 mm forward from rear face.
         - left imager is 47.5 mm from the 1/4-20 centreline.
           => y = +47.5 mm to the camera/robot left.
         Keep z = 0 because the imager is on the depth module centreline. -->
    <origin xyz="0.02145 0.04750 0" rpy="0 0 0" />
    <parent link="rs_d456_solid" />
    <child link="front_realsense" />
    <axis xyz="0 0 0" />
  </joint>

</robot>
