Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /RealSense D4561
        - /Go2-W LiDAR Overlay1
        - /Nvblox Outputs1
      Splitter Ratio: 0.5
    Tree Height: 650
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.35
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Image
          Enabled: true
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: color image
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /camera/camera/color/image_raw
          Value: true
        - Class: rviz_default_plugins/Image
          Enabled: true
          Max Value: 5
          Median window: 5
          Min Value: 0
          Name: aligned depth image
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /camera/camera/aligned_depth_to_color/image_raw
          Value: true
      Enabled: true
      Name: RealSense D456
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.35
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 205; 40
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: /utlidar/cloud_deskewed overlay
          Position Transformer: XYZ
          Size (Pixels): 3
          Size (m): 0.03
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /utlidar/cloud_deskewed
          Use Fixed Frame: true
          Value: true
      Enabled: true
      Name: Go2-W LiDAR Overlay
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: mesh markers candidate
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /nvblox_node/mesh
          Value: true
        - Alpha: 0.7
          Class: rviz_default_plugins/PointCloud2
          Color: 0; 180; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Name: ESDF pointcloud placeholder
          Position Transformer: XYZ
          Size (Pixels): 3
          Size (m): 0.03
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /nvblox_node/esdf_pointcloud
          Use Fixed Frame: true
          Value: false
        - Alpha: 0.7
          Class: rviz_default_plugins/PointCloud2
          Color: 120; 220; 90
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Name: TSDF pointcloud placeholder
          Position Transformer: XYZ
          Size (Pixels): 3
          Size (m): 0.03
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /nvblox_node/tsdf_pointcloud
          Use Fixed Frame: true
          Value: false
        - Class: rviz_default_plugins/Map
          Color Scheme: map
          Draw Behind: false
          Enabled: false
          Name: map slice placeholder
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /nvblox_node/static_map_slice
          Update Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /nvblox_node/static_map_slice_updates
          Use Timestamp: false
          Value: false
      Enabled: true
      Name: Nvblox Outputs
  Enabled: true
  Global Options:
    Background Color: 35; 38; 42
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Yaw: 0.78
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 60
  Y: 60
