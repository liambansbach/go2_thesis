Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /Go2-W LiDAR1
        - /Go2-W Odometry1
        - /RealSense D4561
      Splitter Ratio: 0.5
    Tree Height: 650
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.35
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.75
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: /utlidar/cloud
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.035
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /utlidar/cloud
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 0.55
          Class: rviz_default_plugins/PointCloud2
          Color: 45; 180; 120
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: /utlidar/cloud_base
          Position Transformer: XYZ
          Size (Pixels): 3
          Size (m): 0.035
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /utlidar/cloud_base
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.65
          Class: rviz_default_plugins/PointCloud2
          Color: 40; 130; 230
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: /utlidar/cloud_deskewed
          Position Transformer: XYZ
          Size (Pixels): 3
          Size (m): 0.035
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /utlidar/cloud_deskewed
          Use Fixed Frame: true
          Value: true
      Enabled: true
      Name: Go2-W LiDAR
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Odometry
          Color: 255; 190; 40
          Enabled: true
          Name: /utlidar/robot_odom
          Position Tolerance: 0.1
          Shape: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /utlidar/robot_odom
          Value: true
        - Class: rviz_default_plugins/Odometry
          Color: 110; 210; 255
          Enabled: true
          Name: /uslam/localization/odom
          Position Tolerance: 0.1
          Shape: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /uslam/localization/odom
          Value: true
        - Class: rviz_default_plugins/Odometry
          Color: 230; 120; 255
          Enabled: true
          Name: /lio_sam_ros2/mapping/odometry
          Position Tolerance: 0.1
          Shape: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /lio_sam_ros2/mapping/odometry
          Value: true
      Enabled: true
      Name: Go2-W Odometry
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Image
          Enabled: true
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: color image
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /camera/camera/color/image_raw
          Value: true
        - Class: rviz_default_plugins/Image
          Enabled: true
          Max Value: 5
          Median window: 5
          Min Value: 0
          Name: aligned depth image
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /camera/camera/aligned_depth_to_color/image_raw
          Value: true
        - Alpha: 0.35
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: false
          Name: /camera/camera/points optional
          Position Transformer: XYZ
          Size (Pixels): 2
          Size (m): 0.02
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /camera/camera/points
          Use Fixed Frame: true
          Value: false
      Enabled: true
      Name: RealSense D456
  Enabled: true
  Global Options:
    Background Color: 35; 38; 42
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Yaw: 0.78
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 40
  Y: 40
