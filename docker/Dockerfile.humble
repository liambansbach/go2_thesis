FROM osrf/ros:humble-desktop

ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV ROS_DOMAIN_ID=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

RUN CUDA_REPO_ARCH="$(dpkg --print-architecture)" && \
    if [ "$CUDA_REPO_ARCH" = "amd64" ]; then CUDA_REPO_ARCH="x86_64"; fi && \
    if [ "$CUDA_REPO_ARCH" = "arm64" ]; then CUDA_REPO_ARCH="sbsa"; fi && \
    curl -fsSL "https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/${CUDA_REPO_ARCH}/3bf863cc.pub" \
    | gpg --dearmor -o /usr/share/keyrings/cuda-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/cuda-archive-keyring.gpg] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/${CUDA_REPO_ARCH}/ /" \
    > /etc/apt/sources.list.d/cuda-ubuntu2204.list && \
    curl -fsSL https://isaac.download.nvidia.com/isaac-ros/repos.key \
    | gpg --dearmor -o /usr/share/keyrings/isaac-ros-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/isaac-ros-archive-keyring.gpg] https://isaac.download.nvidia.com/isaac-ros/release-3 jammy release-3.0" \
    > /etc/apt/sources.list.d/isaac-ros-release-3.list && \
    curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
    | gpg --dearmor -o /usr/share/keyrings/nvidia-jetson-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/nvidia-jetson-archive-keyring.gpg] https://repo.download.nvidia.com/jetson/x86_64/jammy r36.2 main" \
    > /etc/apt/sources.list.d/nvidia-vpi3-jammy.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    jq \
    tar \
    nano \
    vim \
    tmux \
    tree \
    htop \
    sudo \
    iproute2 \
    net-tools \
    iputils-ping \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    python3-argcomplete \
    libyaml-cpp-dev \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libeigen3-dev \
    libpcl-dev \
    cuda-cudart-12-6 \
    libnpp-12-6 \
    libnvvpi3 \
    ros-humble-rqt-image-view \
	    ros-humble-compressed-image-transport \
	    ros-humble-domain-bridge \
	    ros-humble-image-proc \
    ros-humble-depth-image-proc \
    ros-humble-realsense2-camera \
    ros-humble-realsense2-description \
    ros-humble-realsense2-camera-msgs \
    ros-humble-isaac-ros-nvblox \
    ros-humble-tf-transformations \
    ros-humble-ros2bag \
    ros-humble-tf2-sensor-msgs \
    ros-humble-message-filters \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rosidl-generator-dds-idl \
    ros-humble-tf2-tools \
    ros-humble-tf2-ros \
    ros-humble-robot-state-publisher \
    ros-humble-joint-state-publisher \
    ros-humble-xacro \
    ros-humble-rviz2 \
    ros-humble-rqt \
    ros-humble-rqt-graph \
    ros-humble-image-transport \
    ros-humble-cv-bridge \
    ros-humble-sensor-msgs \
    ros-humble-nav-msgs \
    ros-humble-geometry-msgs \
    ros-humble-grid-map-msgs \
    ros-humble-pcl-ros \
    ros-humble-pcl-conversions \
    ros-humble-rosbag2-storage-mcap \
    ros-humble-grid-map-core \
    ros-humble-grid-map-ros \
    ros-humble-grid-map-cv \
    ros-humble-grid-map-filters \
    ros-humble-grid-map-visualization \
    ros-humble-grid-map-rviz-plugin \
    ros-humble-tf2-eigen \
    ros-humble-eigen3-cmake-module \
    v4l-utils \
    usbutils \
    && rm -rf /var/lib/apt/lists/*

RUN ARCH="$(dpkg --print-architecture)" && \
    if [ "$ARCH" = "amd64" ]; then \
      printf '/usr/local/cuda-12.6/targets/x86_64-linux/lib\n/opt/nvidia/vpi3/lib/x86_64-linux-gnu\n' > /etc/ld.so.conf.d/nvidia-cuda-vpi.conf; \
    elif [ "$ARCH" = "arm64" ]; then \
      printf '/usr/local/cuda-12.6/targets/aarch64-linux/lib\n/opt/nvidia/vpi3/lib/aarch64-linux-gnu\n' > /etc/ld.so.conf.d/nvidia-cuda-vpi.conf; \
    fi && \
    ldconfig

COPY requirements/perception.txt /tmp/perception.txt
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --no-cache-dir --ignore-installed -r /tmp/perception.txt

RUN git clone --depth 1 https://github.com/unitreerobotics/unitree_ros2.git /opt/unitree_ros2 && \
    /bin/bash -c "source /opt/ros/humble/setup.bash && \
    cd /opt/unitree_ros2/cyclonedds_ws && \
    colcon build --symlink-install"

RUN groupadd --gid ${USER_GID} ${USERNAME} || true && \
    useradd --uid ${USER_UID} --gid ${USER_GID} -m ${USERNAME} || true && \
    usermod -aG sudo ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME}

COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

# Make the Go2 ROS environment available in every interactive docker exec shell.
RUN printf '%s\n' \
    '' \
    '# >>> go2 thesis ros environment >>>' \
    'if [[ $- == *i* ]]; then' \
    '  if [ -z "${GO2_THESIS_BASHRC_ENV_LOADED:-}" ]; then' \
    '    export GO2_THESIS_BASHRC_ENV_LOADED=1' \
    '' \
    '    export GO2_THESIS_DIR="${GO2_THESIS_DIR:-/workspaces/go2_thesis}"' \
    '    export ROS_DISTRO="${ROS_DISTRO:-humble}"' \
    '' \
    '    if [ -f "/opt/ros/${ROS_DISTRO}/setup.bash" ]; then' \
    '      source "/opt/ros/${ROS_DISTRO}/setup.bash"' \
    '    fi' \
    '' \
    '    if [ -f /opt/unitree_ros2/cyclonedds_ws/install/setup.bash ]; then' \
    '      source /opt/unitree_ros2/cyclonedds_ws/install/setup.bash' \
    '    fi' \
    '' \
    '    if [ -f "${GO2_THESIS_DIR}/third_party/unitree_ros2_example/install/setup.bash" ]; then' \
    '      source "${GO2_THESIS_DIR}/third_party/unitree_ros2_example/install/setup.bash"' \
    '    fi' \
    '' \
    '    if [ -f "${GO2_THESIS_DIR}/ros2_ws/install/setup.bash" ]; then' \
    '      source "${GO2_THESIS_DIR}/ros2_ws/install/setup.bash"' \
    '    fi' \
    '' \
    '    export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_cyclonedds_cpp}"' \
    '    export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"' \
    '' \
    '    if [ -n "${ROS_NET_IFACE:-}" ]; then' \
    '      export CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface name=\"${ROS_NET_IFACE}\" priority=\"default\" multicast=\"default\" /></Interfaces></General></Domain></CycloneDDS>"' \
    '    fi' \
    '' \
    '    if [ "${GO2_ENV_VERBOSE:-0}" = "1" ]; then' \
    '      echo "Go2 thesis ROS environment loaded from ${GO2_THESIS_DIR}"' \
    '    fi' \
    '  fi' \
    '' \
    "  alias go2cd='cd \"\${GO2_THESIS_DIR:-/workspaces/go2_thesis}\"'" \
    "  alias go2ws='cd \"\${GO2_THESIS_DIR:-/workspaces/go2_thesis}/ros2_ws\"'" \
    "  alias go2buildws='cd \"\${GO2_THESIS_DIR:-/workspaces/go2_thesis}\" && ./scripts/setup/build_ros2_ws.sh'" \
    "  alias go2topics='ros2 topic list'" \
    "  alias go2nodes='ros2 node list'" \
    'fi' \
    '# <<< go2 thesis ros environment <<<' \
    >> /etc/bash.bashrc

WORKDIR /workspaces/go2_thesis

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
